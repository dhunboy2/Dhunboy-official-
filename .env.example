# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google OAuth 2.0 Credentials for Dhunboy Official YouTube Channel Connection
# Set these in your Google Cloud Console (OAuth 2.0 Client IDs for Web application)
# Authorized Redirect URI: {APP_URL}/api/auth/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# YouTube Data API v3 Key (Optional, for quota optimization on public read operations)
YOUTUBE_API_KEY=""

# Secret key for encrypting OAuth tokens in local persistent storage (generate with crypto.randomBytes(64).toString('hex'))
ENCRYPTION_SECRET=""

